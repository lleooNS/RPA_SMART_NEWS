# ============================================================
# RPA_SMART_NEWS - Variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e ajuste conforme necessário.
# ============================================================

# ----- Logging -----
# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ----- Input do usuário -----
# Tentativas de input antes de abortar a execução
MAX_RETRIES=3

# ----- Saída -----
# Diretório de saída para os PDFs gerados
OUTPUT_DIR=output

# ----- Selenium / Navegador -----
# Se TRUE, abre o Chrome sem interface (apenas para debug/CI)
HEADLESS=false
# Timeout (s) padrão das esperas explícitas
SELENIUM_TIMEOUT=15
# Faixa de delays randomizados (s) que humanizam a navegação
HUMANIZE_DELAY_MIN=0.8
HUMANIZE_DELAY_MAX=2.5
# Máximo de notícias coletadas por site (por execução)
MAX_NEWS_PER_SITE=15
# User-Agent enviado pelo Chrome controlado
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ----- LLM (sumarização) -----
# Provedor: 'stub' (offline, determinístico) ou 'openai'
LLM_PROVIDER=stub
# Modelo (usado quando LLM_PROVIDER != 'stub')
LLM_MODEL=gpt-4o-mini
# API key do provedor (deixe vazio para o stub)
LLM_API_KEY=
# Temperatura e limite de tokens da chamada
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
