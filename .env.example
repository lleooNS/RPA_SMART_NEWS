# ============================================================
# RPA_SMART_NEWS - Variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e ajuste conforme necessário.
# ============================================================

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Limite máximo de dias aceitos no input do usuário (1-10 nesta versão)
MAX_DAYS=10

# Tentativas de input antes de abortar a execução
MAX_RETRIES=3

# Diretório de saída para os PDFs gerados
OUTPUT_DIR=output
