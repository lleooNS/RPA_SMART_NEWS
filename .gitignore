# ============================================================
# .gitignore - RPA_SMART_NEWS
# Python / Selenium / IA Generativa
# ============================================================

# ----- Ambiente Virtual -----
.venv/
venv/
env/
ENV/
.python-version

# ----- Bytecode / Compilados -----
__pycache__/
*.py[cod]
*$py.class
*.so

# ----- Distribuição / Packaging -----
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ----- Cache de testes -----
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# ----- Type checkers / Linters -----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ----- Jupyter -----
.ipynb_checkpoints
profile_default/
ipython_config.py

# ----- Variáveis de ambiente / Secrets -----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# ----- Selenium / Drivers / Logs do navegador -----
geckodriver.log
chromedriver.log
*.log
logs/
selenium-debug.log

# ----- Saídas geradas pelo RPA -----
output/
outputs/
downloads/
*.pdf
!docs/**/*.pdf
screenshots/
temp/
tmp/

# ----- IDEs / Editores -----
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ----- Cursor -----
.cursor/
# Contexto local para agentes Cursor (briefing de chats novos)
CURSOR_CONTEXT.md

# ----- SO -----
desktop.ini
